# ---------------------------------------------------------------
# Versions. Change these in one place; images rebuild on `make up`.
# ---------------------------------------------------------------
SPARK_VERSION=4.1.3
SPARK_IMAGE=apache/spark:4.1.3-scala2.13-java17-python3-ubuntu
KYUUBI_VERSION=1.12.0
HIVE_IMAGE=apache/hive:3.1.3
POSTGRES_JDBC_VERSION=42.7.4

# Object storage: RustFS (S3-compatible, Apache-2.0). MinIO no longer
# publishes free images, so the lab doesn't use any MinIO images at all.
RUSTFS_IMAGE=rustfs/rustfs:1.0.1
# Official AWS CLI, used only to create buckets and upload files.
AWS_CLI_IMAGE=amazon/aws-cli:2.37.12

# Host ports for RustFS. 9100/9101 so this lab doesn't collide with a
# RustFS/MinIO you already run on 9000/9001. Inside Docker it is
# always http://rustfs:9000.
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101

# ---------------------------------------------------------------
# Credentials (lab only). If you change the RustFS ones, also change
# conf/spark/spark-defaults.conf and conf/hive/hive-site.xml.
# ---------------------------------------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123

POSTGRES_DB=metastore
POSTGRES_USER=hive
POSTGRES_PASSWORD=hivepass

# Worker size. Keep Docker Desktop at 8 GB RAM / 4 CPUs or more.
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g

# ---------------------------------------------------------------
# Lakehouse table formats (downloaded by the lakehouse-init service).
# Artifacts are picked for the Spark minor version above:
#   io.delta:delta-spark_4.1_2.13
#   org.apache.iceberg:iceberg-spark-runtime-4.1_2.13
#   org.apache.hudi:hudi-spark4.1-bundle_2.13
# After changing one: docker compose run --rm lakehouse-init
# ---------------------------------------------------------------
DELTA_VERSION=4.4.0
ICEBERG_VERSION=1.12.0
HUDI_VERSION=1.2.0

# ---------------------------------------------------------------
# Kafka (KRaft) and its web UI (http://localhost:8090)
# Spark's Kafka connector is fetched by lakehouse-init to match Spark.
# ---------------------------------------------------------------
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
